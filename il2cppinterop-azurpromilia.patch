+            public bool SizeInited
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_size_inited);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_size_inited, value);
+            }
+
+            public bool HasFinalize
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_has_finalize);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_has_finalize, value);
+            }
+
+            public bool IsVtableInitialized
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_is_vtable_initialized);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_29_0_Padded.Bitfield1.BIT_is_vtable_initialized, value);
+            }
