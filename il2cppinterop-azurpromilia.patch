+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_enumtype);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_enumtype, value);
+            }
+
