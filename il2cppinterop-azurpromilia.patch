+        /// <c>jmp qword ptr [rip+disp32]</c> and <c>mov rax, imm64; jmp rax</c>. Returns zero when
+        /// the chain leaves the module or does not terminate within a few hops.
+        /// </summary>
+        private static nint FollowJumpStub(nint address, long moduleStart, long moduleEnd)
+        {
+            var current = (long)address;
+
+            for (var hop = 0; hop < 4; hop++)
+            {
+                if (current < moduleStart || current + 16 > moduleEnd)
+                    return IntPtr.Zero;
+
+                var code = (byte*)current;
+                long next;
+
+                if (code[0] == 0xE9) // jmp rel32
+                {
+                    next = current + 5 + *(int*)(code + 1);
+                }
+                else if (code[0] == 0xFF && code[1] == 0x25) // jmp qword ptr [rip + disp32]
+                {
+                    var slot = current + 6 + *(int*)(code + 2);
+                    if (slot < moduleStart || slot + sizeof(long) > moduleEnd) return IntPtr.Zero;
+                    next = *(long*)slot;
+                }
+                else if (code[0] == 0x48 && code[1] == 0xB8 && code[10] == 0xFF && code[11] == 0xE0)
+                {
+                    next = *(long*)(code + 2); // mov rax, imm64; jmp rax
+                }
+                else
+                {
+                    return (nint)current; // already at the body
+                }
+
+                if (next < moduleStart || next >= moduleEnd)
+                    return IntPtr.Zero;
+
+                current = next;
+            }
+
+            return IntPtr.Zero;
+        }
+
+        private static bool LooksLikeFunctionStart(byte* code)
+        {
+            // il2cpp prologues start with a push (0x40/0x48/0x4C REX-prefixed push, 0x53 push rbx,
+            // 0x55 push rbp, 0x56/0x57 push rsi/rdi) or a REX.W mov.
+            return code[0] is 0x40 or 0x48 or 0x4C or 0x53 or 0x55 or 0x56 or 0x57;
+        }
         #endregion
     }
 }
diff --git a/Il2CppInterop.Runtime/Runtime/CrashGuard.cs b/Il2CppInterop.Runtime/Runtime/CrashGuard.cs
new file mode 100644
index 0000000..a78d0b5
--- /dev/null
+++ b/Il2CppInterop.Runtime/Runtime/CrashGuard.cs
@@ -0,0 +1,275 @@
+﻿using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Runtime.ExceptionServices;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace Il2CppInterop.Runtime.Runtime;
+
+/// <summary>
+/// Writes a native crash report next to the runtime assembly.
+///
+/// A game that installs il2cpp detours can die with no managed exception, no WER event and no
+/// crash dump, which leaves nothing to debug from. A vectored exception handler sees the fault
+/// before the CRT does, so at minimum the exception code and faulting address get recorded; the
+/// address is then mapped back to module + RVA so it can be disassembled statically.
+///
+/// Only fatal codes are recorded - C++ exceptions and breakpoints are used for ordinary control
+/// flow inside il2cpp and would drown the log.
+/// </summary>
+internal static unsafe class CrashGuard
+{
+    private const uint ExceptionAccessViolation = 0xC0000005;
+    private const uint ExceptionStackOverflow = 0xC00000FD;
+    private const uint ExceptionFailFast = 0xC0000409;
+    private const uint ExceptionHeapCorruption = 0xC0000374;
+    private const uint ExceptionIllegalInstruction = 0xC000001D;
+    private const uint ExceptionInPageError = 0xC0000006;
+    private const uint ExceptionGuardPage = 0x80000001;
+
+    private const int MaxReports = 24;
+
+    private static int s_reports;
+    private static readonly List<(string Name, long Start, long End)> s_modules = new();
+    private static readonly object s_lock = new();
+    private static string s_logPath;
+
+    private delegate int VectoredHandler(IntPtr exceptionPointers);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern IntPtr AddVectoredExceptionHandler(uint first, VectoredHandler handler);
+
+    private static VectoredHandler s_handler; // keep a root so the delegate is not collected
+
+    public static void Install()
+    {
+        if (s_handler != null) return;
+
+        try
+        {
+            var dir = Path.GetDirectoryName(typeof(CrashGuard).Assembly.Location);
+            if (string.IsNullOrEmpty(dir)) return;
+            s_logPath = Path.Combine(dir, "il2cppinterop.crash.txt");
+
+            foreach (ProcessModule module in Process.GetCurrentProcess().Modules)
+            {
+                try
+                {
+                    s_modules.Add((module.ModuleName, module.BaseAddress.ToInt64(),
+                        module.BaseAddress.ToInt64() + module.ModuleMemorySize));
+                }
+                catch
+                {
+                    // Some system modules throw on access; skipping one is harmless.
+                }
+            }
+
+            s_handler = OnException;
+            AddVectoredExceptionHandler(1, s_handler);
+
+            s_exceptionPath = Path.Combine(dir, "il2cppinterop.exceptions.txt");
+            InstallManagedHandlers();
+            RedirectStandardError(dir);
+
+            Append($"--- crash guard installed, {s_modules.Count} modules mapped ---");
+        }
+        catch
+        {
+            // Diagnostics must never take the process down on their own.
+        }
+    }
+
+
+    private const int StdErrorHandle = -12;
+
+    private static FileStream s_stderrStream; // keep alive: the handle must outlive this call
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool SetStdHandle(int nStdHandle, IntPtr hHandle);
+
+    /// <summary>
+    /// A CLR failfast writes its reason straight to the process stderr handle and exits, so neither
+    /// a managed handler nor a vectored handler ever sees the text - the game just disappears with
+    /// nothing in the log. Pointing STD_ERROR_HANDLE at a file makes that message readable.
+    /// </summary>
+    private static void RedirectStandardError(string dir)
+    {
+        try
+        {
+            var path = Path.Combine(dir, "il2cppinterop.stderr.txt");
+            s_stderrStream = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.ReadWrite);
+            SetStdHandle(StdErrorHandle, s_stderrStream.SafeFileHandle.DangerousGetHandle());
+        }
+        catch
+        {
+            // Diagnostics must never take the process down on their own.
+        }
+    }
+
+    private static int OnException(IntPtr exceptionPointers)
+    {
+        try
+        {
+            if (s_reports++ >= MaxReports) return 0;
+
+            var record = *(ExceptionRecord**)exceptionPointers;
+            var code = (uint)record->ExceptionCode;
+            if (!IsFatal(code)) return 0;
+
+            var address = (long)record->ExceptionAddress;
+            var where = Resolve(address);
+
+            var detail = new StringBuilder();
+            detail.Append("code=0x").Append(code.ToString("X8"));
+            detail.Append(" addr=0x").Append(address.ToString("X"));
+            detail.Append(" at=").Append(where);
+
+            if (code == ExceptionAccessViolation && record->NumberParameters >= 2)
+            {
+                var kind = record->ExceptionInformation[0] == 0 ? "read" : record->ExceptionInformation[0] == 1 ? "write" : "execute";
+                detail.Append(" op=").Append(kind);
+                detail.Append(" target=0x").Append(((long)record->ExceptionInformation[1]).ToString("X"));
+            }
+
+            Append(detail.ToString());
+        }
+        catch
+        {
+            // Swallow: an exception inside the handler would recurse.
+        }
+
+        return 0; // EXCEPTION_CONTINUE_SEARCH
+    }
+
+    private static string s_exceptionPath;
+    private static int s_exceptionTotal;
+    private static readonly Dictionary<string, int> s_exceptionCounts = new();
+    private const int MaxExceptions = 400;
+    private const int MaxExceptionsPerType = 15;
+
+    /// <summary>
+    /// A CLR fatal error and an unhandled managed exception both end the process with output on
+    /// stderr only, which MelonLoader's file log never sees. Subscribing to the managed events
+    /// turns that invisible death into a written-down one.
+    ///
+    /// FirstChanceException also captures exceptions that are caught further up - that is what
+    /// makes an il2cpp <c>ExecutionEngineException</c> during AddComponent visible even though
+    /// Unity swallows it and merely logs "The script 'X' could not be instantiated!".
+    /// </summary>
+    private static void InstallManagedHandlers()
+    {
+        try
+        {
+            AppDomain.CurrentDomain.FirstChanceException += OnFirstChanceException;
+            AppDomain.CurrentDomain.UnhandledException += OnUnhandledException;
+        }
+        catch
+        {
+            // Diagnostics must never take the process down on their own.
+        }
+    }
+
+    private static void OnFirstChanceException(object sender, FirstChanceExceptionEventArgs e)
+    {
+        try
+        {
+            var exception = e.Exception;
+            if (exception == null) return;
+
+            var type = exception.GetType().FullName ?? "<unknown>";
+            int seen;
+            lock (s_lock)
+            {
+                if (s_exceptionTotal >= MaxExceptions) return;
+                s_exceptionCounts.TryGetValue(type, out seen);
+                if (seen >= MaxExceptionsPerType) return;
+                s_exceptionCounts[type] = seen + 1;
+                s_exceptionTotal++;
+            }
+
+            WriteException($"fce {type}: {exception.Message}{Environment.NewLine}{ShortStack(exception)}");
+        }
+        catch
+        {
+            // Swallow: an exception inside the handler would recurse.
+        }
+    }
+
+    private static void OnUnhandledException(object sender, UnhandledExceptionEventArgs e)
+    {
+        try
+        {
+            var text = e.ExceptionObject?.ToString() ?? "<null>";
+            WriteException($"UNHANDLED terminating={e.IsTerminating}{Environment.NewLine}{text}");
+        }
+        catch
+        {
+        }
+    }
+
+    private static string ShortStack(Exception exception)
+    {
+        var stack = exception.StackTrace;
+        if (string.IsNullOrEmpty(stack)) return "    <no stack>";
+
+        var lines = stack.Split('\n');
+        var builder = new StringBuilder();
+        for (var i = 0; i < lines.Length && i < 8; i++)
+            builder.Append("    ").Append(lines[i].TrimEnd()).Append(Environment.NewLine);
+
+        return builder.ToString();
+    }
+
+    private static void WriteException(string text)
+    {
+        if (string.IsNullOrEmpty(s_exceptionPath)) return;
+
+        lock (s_lock)
+        {
+            File.AppendAllText(s_exceptionPath,
+                $"[{DateTime.Now:HH:mm:ss.fff}] {text}{Environment.NewLine}");
+        }
+    }
+
+    private static bool IsFatal(uint code)
+    {
+        return code is ExceptionAccessViolation or ExceptionStackOverflow or ExceptionFailFast
+            or ExceptionHeapCorruption or ExceptionIllegalInstruction or ExceptionInPageError
+            or ExceptionGuardPage;
+    }
+
+    private static string Resolve(long address)
+    {
+        foreach (var module in s_modules)
+        {
+            if (address < module.Start || address >= module.End) continue;
+            return $"{module.Name}+0x{(address - module.Start):X}";
+        }
+
+        return "<unmapped>";
+    }
+
+    private static void Append(string line)
+    {
+        if (string.IsNullOrEmpty(s_logPath)) return;
+
+        lock (s_lock)
+        {
+            File.AppendAllText(s_logPath,
+                $"[{DateTime.Now:HH:mm:ss.fff}] {line}{Environment.NewLine}");
+        }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct ExceptionRecord
+    {
+        public int ExceptionCode;
+        public int ExceptionFlags;
+        public IntPtr ExceptionRecordPtr;
+        public IntPtr ExceptionAddress;
+        public int NumberParameters;
+        public fixed long ExceptionInformation[15];
+    }
+}
diff --git a/Il2CppInterop.Runtime/Runtime/LayoutProbe.cs b/Il2CppInterop.Runtime/Runtime/LayoutProbe.cs
new file mode 100644
index 0000000..d387a86
--- /dev/null
+++ b/Il2CppInterop.Runtime/Runtime/LayoutProbe.cs
@@ -0,0 +1,206 @@
+using System;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Common;
+using Microsoft.Extensions.Logging;
+
+namespace Il2CppInterop.Runtime.Runtime;
+
+/// <summary>
+/// Some games ship an il2cpp runtime that is patched relative to stock Unity while still reporting
+/// a stock Unity version. Il2CppInterop picks its struct handlers from that reported version, so a
+/// fork silently gets the wrong layout and every field past the insertion point reads garbage.
+///
+/// This probe measures the real layout of the running module instead of trusting the version
+/// string: it asks the engine for a class/method through the il2cpp exports (which always use the
+/// true offsets) and compares the answer with what the stock struct offsets yield.
+///
+/// Two things are measured:
+///
+/// 1. <b>Which layout family the runtime is built on.</b> The 2021.x family puts Il2CppClass.flags
+///    at 0x114, the 2022.x family puts it at 0x118 (that struct gained stack_slot_size and lost
+///    naturalAligment). This matters twice: the padding probe below is anchored on the family's
+///    stock offsets, and the padded handler we ship models the 2021.x struct.
+///
+/// 2. <b>How many bytes the runtime inserts.</b> Layouts confirmed against two shipped games:
+///
+///      Endfield      (Unity 2021.3.34f5, metadata 29) - reports the 2021.x family
+///      Azur Promilia (Unity 2022.3.62f3, metadata 31) - <i>also</i> reports the 2021.x family,
+///                                                       even though its Unity version string
+///                                                       makes Il2CppInterop select the 2022.x
+///                                                       handlers
+///
+///    Both insert the same amount:
+///      Il2CppClass      - two extra bytes after `token`      (method_count 0x11C -> 0x11E)
+///      Il2CppMethodInfo - one extra byte after `slot`        (parameters_count 0x52 -> 0x53)
+///
+/// So the measured padding, not the Unity version, is what decides whether the padded handlers apply.
+/// </summary>
+internal static class Il2CppLayoutProbe
+{
+    /// <summary>Il2CppClass.flags in the 2021.x (metadata 29) struct.</summary>
+    private const int ClassFlagsOffset2021 = 0x114;
+
+    /// <summary>Il2CppClass.flags in the 2022.x (metadata 31) struct.</summary>
+    private const int ClassFlagsOffset2022 = 0x118;
+
+    private const int ClassMethodCountOffset2021 = 0x11C;
+    private const int ClassMethodCountOffset2022 = 0x120;
+
+    private const int MethodInfoParametersCountOffset = 0x52;
+
+    private static bool s_ran;
+
+    /// <summary>Which stock struct the running runtime is built on.</summary>
+    public enum LayoutFamily
+    {
+        Unknown = 0,
+        V2021 = 1,
+        V2022 = 2
+    }
+
+    public static LayoutFamily Family { get; private set; }
+
+    /// <summary>Extra bytes between `token` and `method_count` in <c>Il2CppClass</c>.</summary>
+    public static int ClassStructPadding { get; private set; }
+
+    /// <summary>Extra bytes between `slot` and `parameters_count` in <c>Il2CppMethodInfo</c>.</summary>
+    public static int MethodInfoStructPadding { get; private set; }
+
+    public static void Run()
+    {
+        if (s_ran) return;
+        s_ran = true;
+
+        try
+        {
+            var klass = FindProbeClass();
+            if (klass == IntPtr.Zero)
+            {
+                Logger.Instance.LogWarning("il2cpp layout probe: no probe class found, assuming stock layout");
+                return;
+            }
+
+            ProbeFamily(klass);
+            ProbeClassLayout(klass);
+            ProbeMethodInfoLayout(klass);
+
+            Logger.Instance.LogInformation(
+                "il2cpp layout probe: {Family} structs, Il2CppClass +{ClassPad} byte(s), Il2CppMethodInfo +{MethodPad} byte(s)",
+                Family, ClassStructPadding, MethodInfoStructPadding);
+        }
+        catch (Exception ex)
+        {
+            Logger.Instance.LogWarning("il2cpp layout probe failed, assuming stock layout: {Message}", ex.Message);
+        }
+    }
+
+    private static IntPtr FindProbeClass()
+    {
+        var corlib = IL2CPP.il2cpp_get_corlib();
+        if (corlib == IntPtr.Zero) return IntPtr.Zero;
+
+        string[] candidates = { "String", "Object", "Exception", "Int32" };
+        foreach (var name in candidates)
+        {
+            var klass = IL2CPP.il2cpp_class_from_name(corlib, "System", name);
+            if (klass != IntPtr.Zero) return klass;
+        }
+
+        return IntPtr.Zero;
+    }
+
+    /// <summary>
+    /// The engine always reads flags from the offset its own struct uses, so comparing that value
+    /// against both candidate offsets identifies the family without guessing.
+    /// </summary>
+    private static void ProbeFamily(IntPtr klass)
+    {
+        var engineFlags = unchecked((uint)IL2CPP.il2cpp_class_get_flags(klass));
+
+        var at2021 = ReadUInt32(klass + ClassFlagsOffset2021);
+        var at2022 = ReadUInt32(klass + ClassFlagsOffset2022);
+
+        if (at2021 == engineFlags)
+        {
+            Family = LayoutFamily.V2021;
+        }
+        else if (at2022 == engineFlags)
+        {
+            Family = LayoutFamily.V2022;
+        }
+        else
+        {
+            Family = LayoutFamily.Unknown;
+            Logger.Instance.LogWarning(
+                "il2cpp layout probe: Il2CppClass.flags is at neither 0x{Off2021:X} nor 0x{Off2022:X} (engine says 0x{Flags:X}, found 0x{A:X} / 0x{B:X})",
+                ClassFlagsOffset2021, ClassFlagsOffset2022, engineFlags, at2021, at2022);
+        }
+    }
+
+    private static void ProbeClassLayout(IntPtr klass)
+    {
+        var counted = CountMethods(klass);
+        if (counted <= 0) return;
+
+        var stockOffset = Family == LayoutFamily.V2022
+            ? ClassMethodCountOffset2022
+            : ClassMethodCountOffset2021;
+
+        var atStock = ReadUInt16(klass + stockOffset);
+        var atShifted = ReadUInt16(klass + stockOffset + 2);
+
+        if (atStock == counted) ClassStructPadding = 0;
+        else if (atShifted == counted) ClassStructPadding = 2;
+        else
+            Logger.Instance.LogWarning(
+                "il2cpp layout probe: neither 0x{Stock:X} nor 0x{Shifted:X} matches the engine's method count {Count}",
+                atStock, atShifted, counted);
+    }
+
+    private static void ProbeMethodInfoLayout(IntPtr klass)
+    {
+        int stockVotes = 0, shiftedVotes = 0;
+        var iter = IntPtr.Zero;
+
+        for (var i = 0; i < 400; i++)
+        {
+            var method = IL2CPP.il2cpp_class_get_methods(klass, ref iter);
+            if (method == IntPtr.Zero) break;
+
+            var paramCount = (int)IL2CPP.il2cpp_method_get_param_count(method);
+            if (paramCount == 0 || paramCount > 32) continue; // 0 is ambiguous often enough to skip
+
+            if (ReadByte(method + MethodInfoParametersCountOffset) == paramCount) stockVotes++;
+            if (ReadByte(method + MethodInfoParametersCountOffset + 1) == paramCount) shiftedVotes++;
+        }
+
+        if (stockVotes == 0 && shiftedVotes == 0) return;
+
+        MethodInfoStructPadding = shiftedVotes > stockVotes ? 1 : 0;
+
+        if (shiftedVotes == stockVotes)
+            Logger.Instance.LogWarning(
+                "il2cpp layout probe: ambiguous Il2CppMethodInfo layout (stock={Stock} shifted={Shifted})",
+                stockVotes, shiftedVotes);
+    }
+
+    private static int CountMethods(IntPtr klass)
+    {
+        var count = 0;
+        var iter = IntPtr.Zero;
+        while (true)
+        {
+            var method = IL2CPP.il2cpp_class_get_methods(klass, ref iter);
+            if (method == IntPtr.Zero) break;
+            if (++count > 10000) break;
+        }
+
+        return count;
+    }
+
+    private static ushort ReadUInt16(IntPtr address) => unchecked((ushort)Marshal.ReadInt16(address));
+
+    private static uint ReadUInt32(IntPtr address) => unchecked((uint)Marshal.ReadInt32(address));
+
+    private static byte ReadByte(IntPtr address) => Marshal.ReadByte(address);
+}
diff --git a/Il2CppInterop.Runtime/Runtime/TypeLoadProbe.cs b/Il2CppInterop.Runtime/Runtime/TypeLoadProbe.cs
new file mode 100644
index 0000000..cf946e8
--- /dev/null
+++ b/Il2CppInterop.Runtime/Runtime/TypeLoadProbe.cs
@@ -0,0 +1,88 @@
+using System;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using Il2CppInterop.Common;
+using Microsoft.Extensions.Logging;
+
+namespace Il2CppInterop.Runtime.Runtime;
+
+/// <summary>
+/// UniverseLib calls <c>Assembly.GetTypes()</c> on every loaded assembly while building its type
+/// cache, and on some setups the CLR aborts the process part way through with an uncatchable
+/// "Invalid Program" failfast - no managed exception, nothing in the MelonLoader log, so the
+/// offending assembly is impossible to identify afterwards.
+///
+/// Walking the same list here, logging each name *before* the call, turns that abort into a
+/// pointer: the last name without a matching result line is the assembly that killed the process.
+/// </summary>
+internal static class TypeLoadProbe
+{
+    private static int s_ran;
+
+    public static void RunOnce()
+    {
+        if (System.Threading.Interlocked.Exchange(ref s_ran, 1) != 0) return;
+        Run();
+    }
+
+    public static void Run()
+    {
+        Assembly[] assemblies;
+        try
+        {
+            assemblies = AppDomain.CurrentDomain.GetAssemblies();
+        }
+        catch (Exception ex)
+        {
+            Logger.Instance.LogWarning("[typeprobe] could not enumerate assemblies: {Message}", ex.Message);
+            return;
+        }
+
+        Logger.Instance.LogInformation("[typeprobe] probing {Count} loaded assemblies", assemblies.Length);
+
+        foreach (var assembly in assemblies)
+        {
+            string name;
+            try
+            {
+                name = assembly.GetName().Name ?? "<unnamed>";
+            }
+            catch
+            {
+                name = "<unnamed>";
+            }
+
+            // Logged before the call on purpose: if the CLR aborts inside GetTypes, this line is the
+            // only record of what was being loaded.
+            Logger.Instance.LogInformation("[typeprobe] > {Name}", name);
+
+            var result = ProbeTypes(assembly);
+            Logger.Instance.LogInformation("[typeprobe] < {Name} {Result}", name, result);
+        }
+
+        Logger.Instance.LogInformation("[typeprobe] all assemblies survived GetTypes");
+    }
+
+    // Kept out of line so the JIT compiles this method (not the loop above) as the caller of
+    // GetTypes; if the call is what the runtime rejects, the loop still gets its log line out first.
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static string ProbeTypes(Assembly assembly)
+    {
+        try
+        {
+            return $"{assembly.GetTypes().Length} types";
+        }
+        catch (ReflectionTypeLoadException ex)
+        {
+            var loaded = 0;
+            foreach (var type in ex.Types)
+                if (type != null) loaded++;
+
+            return $"ReflectionTypeLoadException {loaded}/{ex.Types.Length} types (catchable)";
+        }
+        catch (Exception ex)
+        {
+            return $"{ex.GetType().Name}: {ex.Message}";
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Runtime/UnityVersionHandler.cs b/Il2CppInterop.Runtime/Runtime/UnityVersionHandler.cs
index 0e4e1f7..a98c992 100644
--- a/Il2CppInterop.Runtime/Runtime/UnityVersionHandler.cs
+++ b/Il2CppInterop.Runtime/Runtime/UnityVersionHandler.cs
@@ -112,6 +112,42 @@ public static class UnityVersionHandler
         parameterInfoStructHandler = GetHandler<INativeParameterInfoStructHandler>();
         propertyInfoStructHandler = GetHandler<INativePropertyInfoStructHandler>();
         typeStructHandler = GetHandler<INativeTypeStructHandler>();
+
+        ApplyDetectedLayoutOverrides();
+    }
+
+    /// <summary>
+    /// Games that ship a patched il2cpp keep the stock Unity version string, so the version-keyed
+    /// handler selection above cannot tell them apart. Probe the live module and swap in the
+    /// matching layout when the runtime has extra fields the stock structs do not model.
+    /// </summary>
+    private static void ApplyDetectedLayoutOverrides()
+    {
+        Il2CppLayoutProbe.Run();
+
+        // The padded handlers model the 2021.x struct with the extra bytes spliced in. They are the
+        // right choice whenever the probe reports that family, whatever handler the Unity version
+        // string picked - a 2022.3 game can still ship a 2021.x-based struct (Azur Promilia does).
+        var classPadded = Il2CppLayoutProbe.ClassStructPadding != 0;
+        if (classPadded && Il2CppLayoutProbe.Family == Il2CppLayoutProbe.LayoutFamily.V2021)
+        {
+            classStructHandler = new NativeClassStructHandler_29_0_Padded();
+        }
+        else if (classPadded)
+        {
+            Logger.Instance.LogWarning(
+                "Detected a padded Il2CppClass layout on {Family} structs, but the padded handler only models the 2021.x struct; keeping {Handler}",
+                Il2CppLayoutProbe.Family, classStructHandler.GetType().Name);
+        }
+
+        var methodPadded = Il2CppLayoutProbe.MethodInfoStructPadding != 0;
+        if (methodPadded)
+        {
+            // Il2CppMethodInfo keeps the same field layout across the 29_0/29_1/29_2 handlers (only
+            // the bitfield enum names differ), so the 29_0-based padded handler is valid for all of
+            // them.
+            methodInfoStructHandler = new NativeMethodInfoStructHandler_29_0_Padded();
+        }
     }
 
     private static T GetHandler<T>()
