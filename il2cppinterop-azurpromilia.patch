+using System;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Type;
+
+namespace Il2CppInterop.Runtime.Runtime.VersionSpecific.Class
+{
+    /// <summary>
+    /// 2021.2+ (metadata v29) <see cref="Il2CppClass"/> layout for runtimes that carry an extra
+    /// 16-bit field between <c>token</c> and <c>method_count</c>.
+    ///
+    /// Stock Unity puts <c>method_count</c> at 0x11C and <c>typeHierarchyDepth</c> at 0x12C.
+    /// Some shipped runtimes (verified against Endfield / 明日方舟：终末地, GameAssembly.dll build
+    /// 2025-11-25) keep every field up to and including <c>token</c> in place but insert two bytes
+    /// right after it, so every following member moves down by two:
+    ///
+    ///   il2cpp_class_is_subclass_of  -> movzx eax, byte ptr [rcx+0x12E]   (typeHierarchyDepth)
+    ///   il2cpp_class_has_references  -> test byte ptr [rcx+0x135], 1      (size_inited)
+    ///   il2cpp_class_get_flags       -> mov eax, dword ptr [rcx+0x114]    (flags, unchanged)
+    ///
+    /// Nothing selects this handler through <see cref="ApplicableToUnityVersionsSinceAttribute"/>:
+    /// the reported Unity version is the stock one, so <see cref="UnityVersionHandler"/> probes the
+    /// live module and swaps this handler in when the padding is present. The struct is still
+    /// 0x138 bytes because the trailing bitfields keep it 8-byte aligned, so vtable placement and
+    /// allocation sizes are unchanged.
+    /// </summary>
+    public unsafe class NativeClassStructHandler_29_0_Padded : INativeClassStructHandler
+    {
+        public int Size() => sizeof(Il2CppClass_29_0_Padded);
+
+        public INativeClassStruct CreateNewStruct(int vTableSlots)
+        {
