+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_is_generic);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_is_generic, value);
+            }
+
+            public bool HasReferences
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_has_references);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_has_references, value);
+            }
