+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_initialized_and_no_error);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_29_0_Padded.Bitfield0.BIT_initialized_and_no_error, value);
+            }
+        }
+    }
